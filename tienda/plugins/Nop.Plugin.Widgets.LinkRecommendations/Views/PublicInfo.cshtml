@model IList<RecommendedProductModel>

<section class="link-recommendations" aria-labelledby="recommendations-title">
    <div class="link-recommendations__heading">
        <p class="link-recommendations__eyebrow">RECOMENDACIÓN PERSONALIZADA</p>
        <h2 id="recommendations-title">Pensamos que te puede gustar</h2>
        <p>Productos sugeridos según compras de clientes con intereses similares.</p>
    </div>

    <div class="link-recommendations__grid">
        @foreach (var product in Model)
        {
            <article class="link-recommendations__card">
                <span class="link-recommendations__sku">@product.Sku</span>
                <h3>@product.Name</h3>
                <p class="link-recommendations__reason">@product.Score cliente@(product.Score == 1 ? string.Empty : "s") con compras similares</p>
                <strong>@product.Price</strong>
                <a href="@product.ProductUrl" class="link-recommendations__button">Ver producto</a>
            </article>
        }
    </div>
</section>

<style>
    .link-recommendations { max-width: 1170px; margin: 34px auto; padding: 28px; border-radius: 14px; background: linear-gradient(135deg,#063970,#075fba); color: #fff; box-sizing: border-box; }
    .link-recommendations__heading { margin-bottom: 22px; }
    .link-recommendations__eyebrow { margin: 0 0 4px; font-size: 12px; font-weight: 700; letter-spacing: .1em; color: #f8cf42; }
    .link-recommendations h2 { margin: 0; color: #fff; font-size: 28px; }
    .link-recommendations__heading > p:last-child { margin: 8px 0 0; }
    .link-recommendations__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .link-recommendations__card { display: flex; flex-direction: column; min-height: 180px; padding: 18px; border-radius: 10px; background: #fff; color: #152b48; }
    .link-recommendations__card h3 { margin: 9px 0; font-size: 18px; }
    .link-recommendations__sku { color: #0b63ce; font-size: 12px; font-weight: 700; }
    .link-recommendations__reason { flex: 1; margin: 0 0 16px; font-size: 13px; color: #50647c; }
    .link-recommendations__card strong { font-size: 18px; color: #063970; }
    .link-recommendations__button { margin-top: 15px; padding: 10px 12px; border-radius: 6px; background: #f8cf42; color: #152b48; font-weight: 700; text-align: center; text-decoration: none; }
    @@media (max-width: 700px) { .link-recommendations { margin: 18px 10px; padding: 20px; } .link-recommendations__grid { grid-template-columns: 1fr; } }
</style>
