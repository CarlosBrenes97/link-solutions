<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputPath>$(SolutionDir)\Presentation\Nop.Web\Plugins\Misc.LinkIaAnalytics</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="plugin.json" />
    <None Remove="Views\_ViewImports.cshtml" />
    <None Remove="Views\Admin\Dashboard.cshtml" />
    <None Remove="Views\Admin\Configure.cshtml" />
    <None Remove="Views\Admin\BrandOverride.cshtml" />
    <None Remove="Content\turritoys-admin-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="plugin.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Views\_ViewImports.cshtml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Views\Admin\Dashboard.cshtml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Views\Admin\Configure.cshtml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Views\Admin\BrandOverride.cshtml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Content\turritoys-admin-logo.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <ItemGroup Condition="'$(UseManualHostReferences)' != 'true'">
    <ProjectReference Include="$(SolutionDir)\Presentation\Nop.Web\Nop.Web.csproj" />
    <ClearPluginAssemblies Include="$(SolutionDir)\Build\ClearPluginAssemblies.proj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseManualHostReferences)' == 'true'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Nop.Core"><HintPath>$(SolutionDir)\Presentation\Nop.Web\bin\Debug\net9.0\Nop.Core.dll</HintPath></Reference>
    <Reference Include="Nop.Data"><HintPath>$(SolutionDir)\Presentation\Nop.Web\bin\Debug\net9.0\Nop.Data.dll</HintPath></Reference>
    <Reference Include="Nop.Services"><HintPath>$(SolutionDir)\Presentation\Nop.Web\bin\Debug\net9.0\Nop.Services.dll</HintPath></Reference>
    <Reference Include="Nop.Web"><HintPath>$(SolutionDir)\Presentation\Nop.Web\bin\Debug\net9.0\Nop.Web.dll</HintPath></Reference>
    <Reference Include="Nop.Web.Framework"><HintPath>$(SolutionDir)\Presentation\Nop.Web\bin\Debug\net9.0\Nop.Web.Framework.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="NopTarget" AfterTargets="Build" Condition="'$(UseManualHostReferences)' != 'true'">
    <MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(OutDir)" Targets="NopClear" />
  </Target>
</Project>
