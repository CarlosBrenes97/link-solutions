# Copiar a .env y completar. El archivo .env NO se sube a Git.
# Formato SQLAlchemy. El controlador ODBC 18 debe estar instalado en la máquina.
SQL_DW=mssql+pyodbc://USUARIO:CLAVE@SERVIDOR.database.windows.net/db-dw?driver=ODBC+Driver+18+for+SQL+Server
# Base de la tienda (usuario de solo lectura). Si se deja vacía, el ETL omite las ventas reales de la tienda.
SQL_TIENDA=mssql+pyodbc://etl_lector:CLAVE@SERVIDOR.database.windows.net/db-tienda?driver=ODBC+Driver+18+for+SQL+Server
# Almacenamiento de los CSV. Si se deja vacío, el ETL lee los CSV de DATA_DIR.
BLOB_CONN=
BLOB_CONTENEDOR=comentarios
DATA_DIR=datos/generador/salida
# Módulo de resumen de comentarios
ANTHROPIC_API_KEY=
MODELO_LLM=claude-haiku-5-5
